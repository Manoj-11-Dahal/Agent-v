{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared agent memory record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "namespace",
    "version",
    "content",
    "source",
    "created_at",
    "allowed_readers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content": {
      "type": "string",
      "maxLength": 16000
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "allowed_readers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "embedding_model": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
